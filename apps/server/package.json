{
  "name": "@spendlens/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts src/security/security-cli.ts --format esm --dts --clean",
    "dev": "node --watch --import tsx src/index.ts",
    "predev": "pnpm --filter @spendlens/db build",
    "pretest": "pnpm --filter @spendlens/db build",
    "security:generate-secret": "node --import tsx src/security/security-cli.ts generate-secret",
    "security:recover": "node --import tsx src/security/security-cli.ts recover",
    "security:setup-token": "node --import tsx src/security/security-cli.ts setup-token",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.0.0",
    "@hono/zod-openapi": "^1.5.1",
    "@spendlens/contracts": "workspace:*",
    "@spendlens/db": "workspace:*",
    "argon2": "^0.44.0",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.0.0",
    "pdfjs-dist": "6.1.200"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pdf-lib": "1.17.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "vitest": "^3.0.0"
  }
}
