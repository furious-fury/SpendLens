# Optional storage locations. Relative paths are resolved from the workspace root.
# SPENDLENS_DATA_DIR=./data
# SPENDLENS_DATABASE_PATH=./data/spendlens.db
# SPENDLENS_SETUP_TOKEN_PATH=./data/setup-token

# Self-hosted mode: mount a 32-byte hexadecimal key in a permission-restricted file.
# Local desktop installations should leave this unset to use the operating-system keyring.
# SPENDLENS_DATABASE_KEY_FILE=/run/secrets/spendlens_database_key

# Remote binding requires secure cookies and an HTTPS reverse proxy.
# SPENDLENS_HOST=127.0.0.1
# SPENDLENS_PORT=4545
# SPENDLENS_SECURE_COOKIES=false
