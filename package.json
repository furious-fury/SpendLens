{
  "name": "spendlens",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first financial statement intelligence",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.13 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm --filter @spendlens/contracts build && pnpm --filter @spendlens/db build && pnpm --filter @spendlens/web build && pnpm --filter @spendlens/server build",
    "predev": "pnpm dev:doctor",
    "dev": "pnpm --parallel --filter @spendlens/server --filter @spendlens/web dev",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "security:generate-secret": "pnpm --filter @spendlens/db build && pnpm --filter @spendlens/server security:generate-secret",
    "security:recover": "pnpm --filter @spendlens/db build && pnpm --filter @spendlens/server security:recover",
    "security:setup-token": "pnpm --filter @spendlens/db build && pnpm --filter @spendlens/server security:setup-token",
    "test": "pnpm --recursive test",
    "typecheck": "pnpm --recursive typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "typescript": "^5.8.0"
  }
}
